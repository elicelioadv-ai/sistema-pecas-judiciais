# Copie este arquivo, renomeie a copia para .env e cole sua chave.
#
# Provedor: "gemini" (padrao) ou "anthropic"
PROVEDOR=gemini

# Chave do Gemini (sem aspas, sem espacos)
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo a usar. Deixe em branco para usar o padrao do provedor.
#   Gemini:    gemini-2.5-flash
#   Anthropic: ex.: claude-sonnet-4-5
MODELO=gemini-2.5-flash

# ---- Seguranca / LGPD -------------------------------------------------------
# Voce declarou que sua conta Google tem faturamento ativo (Paid Services)?
#   sim  -> o provedor NAO usa seus dados para treinar
#   nao  -> cota gratuita: PODE usar seus dados para treinamento (cuidado!)
USO_PAGO=nao

# Modo da chave: "gemini" (padrao) ou "vertex" (Vertex AI / chaves AQ.)
MODO_CHAVE=gemini

# Regiao do Vertex AI (usada apenas no modo vertex). Ex.: southamerica-east1 (Sao Paulo)
REGIAO=

# Se usar o provedor anthropic, informe tambem:
# ANTHROPIC_API_KEY=cole_sua_chave_aqui
ACESSO_USUARIO=
SENHA_ACESSO=

# ---- Backup no GitHub (RECOMENDADO: token que NAO expira) -------------------
# Crie um repositorio PRIVADO para o backup e um token "fine-grained" com
# permissao de ESCRITA em "Contents" (sem validade). Passo a passo no LEIA-ME.
# Se preenchido, o GitHub tem PRIORIDADE sobre o Google Drive.
GITHUB_BACKUP_REPO=usuario/repositorio-de-backup
GITHUB_BACKUP_TOKEN=cole_o_token_aqui
GITHUB_BACKUP_BRANCH=main

# ---- Backup no Google Drive (opcional; alternativa ao GitHub) --------------
# Preenchido automaticamente ao rodar: python autorizar_drive.py
# (veja o passo a passo no LEIA-ME.txt). Sem estes valores, o backup fica off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Pasta destino no Drive (opcional; se vazio, usa/cria "Sistema de Peças Judiciais")
DRIVE_FOLDER_ID=
